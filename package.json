{
  "name": "pi-mcp",
  "version": "1.0.0",
  "description": "mcp client for pi",
  "license": "MIT",
  "author": "Mike Wallio",
  "type": "module",
  "scripts": {
    "build": "tsgo -p ./tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint -c .oxlintrc.json --tsconfig ./tsconfig.json src",
    "lint:fix": "oxlint -c .oxlintrc.json --fix --tsconfig ./tsconfig.json src",
    "test": "vitest"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "^1.1.37",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@oxlint/plugins": "1.83.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.47.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "vitest": "^4.1.10"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
